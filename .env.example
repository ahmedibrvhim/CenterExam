# Copy this file to .env.local and put your free key here. Never commit .env.local.
# Get a free key (no credit card): https://aistudio.google.com/apikey
# Each teacher adds THEIR OWN Gemini key inside the app (saved encrypted in Firestore). No per-teacher variables on Vercel.
# Required: a long random secret used to encrypt the teachers' keys. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it later (old keys could not be decrypted and teachers would have to paste them again).
KEY_ENCRYPTION_SECRET=
# Optional: your own key, used ONLY by admins (ADMIN_EMAILS). Teachers never use it unless ALLOW_SHARED_GEMINI_KEY=1.
GEMINI_API_KEY=
# Optional temporary fallback: 1 = teachers without their own key use GEMINI_API_KEY above.
# ALLOW_SHARED_GEMINI_KEY=1
# Optional: pick another free Flash model
# GEMINI_MODEL=gemini-flash-latest

# Optional but recommended: a free Redis database so the request counter and the "daily limit reached" state are the SAME on every device.
# Vercel: Storage / Marketplace -> Upstash Redis -> connect to the project (it adds these variables for you).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Firebase (Google sign-in) ----
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK config.
# Also enable: Authentication -> Sign-in method -> Google, and add your domain(s) under Authentication -> Settings -> Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional but recommended (fixes "missing initial state" on iPhone): Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration -> Web client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Server (Firebase Admin: subscription codes + admin page) ----
# Firebase Console -> Project settings -> Service accounts -> Generate new private key. Paste the WHOLE json file content as the value.
FIREBASE_SERVICE_ACCOUNT=
# Admin emails (comma separated) that can open /admin and use every subject without a code.
ADMIN_EMAILS=
# Optional: WhatsApp number (digits only, with country code, e.g. 201012345678) shown on the activation screen.
NEXT_PUBLIC_CONTACT_WHATSAPP=
